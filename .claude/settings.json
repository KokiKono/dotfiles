{
  "permissions": {
    "allow": [
      "WebFetch(domain:api.github.com)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-merge.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
