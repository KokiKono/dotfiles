# If you come from bash you might have to change your $PATH.
# export PATH=$HOME/bin:/usr/local/bin:$PATH

# Path to your oh-my-zsh installation.
export ZSH=~/.oh-my-zsh

# Set name of the theme to load. Optionally, if you set this to "random"
# it'll load a random theme each time that oh-my-zsh is loaded.
# See https://github.com/robbyrussell/oh-my-zsh/wiki/Themes
ZSH_THEME="robbyrussell"

plugins=(git)

source $ZSH/oh-my-zsh.sh

# ~/.config/zsh 配下のモジュールを順に読み込む（compinit を含む options を先に）
ZSH_CONF_DIR="${HOME}/.config/zsh"
for _m in options aliases tools; do
  [ -r "$ZSH_CONF_DIR/$_m.zsh" ] && source "$ZSH_CONF_DIR/$_m.zsh"
done

### MANAGED BY RANCHER DESKTOP START (DO NOT EDIT)
export PATH="~/.rd/bin:$PATH"
### MANAGED BY RANCHER DESKTOP END (DO NOT EDIT)

# Privateなシークレットが書かれたファイル（chezmoi 管理外）
[ -f ~/.pzshrc ] && source ~/.pzshrc

# git worktree / branch クリーンアップ関数（wrm/brm/bd）
[ -r "$ZSH_CONF_DIR/git-worktree.zsh" ] && source "$ZSH_CONF_DIR/git-worktree.zsh"
unset _m
