[ghq]
	root = ~/git_clone
[user]
	name = {{ .name }}
	email = {{ .email }}
[core]
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
	pager = cat
[gpg]
	program = gpg
; 署名鍵の ID はマシンごとに異なるので install/macos/gpg.sh が下の include 先に書き出す
; （未作成なら git は黙って無視する）
[include]
	path = {{ .chezmoi.homeDir }}/.config/git/signing.conf
[commit]
	gpgsign = true
	template = {{ .chezmoi.homeDir }}/.stCommitMsg
[url "git@github.com:"]
	insteadOf = https://github.com/
[alias]
	see = browse
	st = status
	f = fetch
	c = checkout
	pf = push --force-with-lease
[diff]
	algorithm = histogram
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /private/var/folders/yf/d_cm0kt9781b95_7nhq0thnc0000gn/T/AppTranslocation/5A3249A1-C2A2-47BE-B57D-0F64665A051E/d/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
